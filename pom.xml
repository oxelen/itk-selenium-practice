<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ru.oxelen</groupId>
    <artifactId>itk-selenium-practice</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <typesafe.version>1.4.2</typesafe.version>
        <junit.version>5.13.4</junit.version>
        <selenium.version>4.52.0</selenium.version>
        <webdrivermanager.version>6.3.3</webdrivermanager.version>
        <lombok.version>1.18.46</lombok.version>
        <maven.surefire.version>3.2.5</maven.surefire.version>

        <youTrack.baseUrl>http://localhost:8080</youTrack.baseUrl>
        <youTrack.admin.login>admin</youTrack.admin.login>
        <youTrack.admin.password>admin</youTrack.admin.password>

        <parallel.enabled>true</parallel.enabled>
        <parallel.mode>concurrent</parallel.mode>
    </properties>

    <profiles>
        <profile>
            <id>same_thread</id>
            <properties>
                <parallel.enabled>false</parallel.enabled>
                <parallel.mode>same_thread</parallel.mode>
            </properties>
        </profile>
    </profiles>

    <!-- Source: https://mvnrepository.com/artifact/com.typesafe/config -->
    <dependencies>
        <dependency>
            <groupId>com.typesafe</groupId>
            <artifactId>config</artifactId>
            <version>${typesafe.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Source: https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Source: https://mvnrepository.com/artifact/org.seleniumhq.selenium/selenium-java -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Source: https://mvnrepository.com/artifact/io.github.bonigarcia/webdrivermanager -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.14.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <YOUTRACK_BASE_URL>${youTrack.baseUrl}</YOUTRACK_BASE_URL>
                        <YOUTRACK_ADMIN_LOGIN>${youTrack.admin.login}</YOUTRACK_ADMIN_LOGIN>
                        <YOUTRACK_ADMIN_PASSWORD>${youTrack.admin.password}</YOUTRACK_ADMIN_PASSWORD>
                    </systemPropertyVariables>
                    <properties>
                        <configurationParameters>
                            junit.jupiter.execution.parallel.enabled = ${parallel.enabled}
                            junit.jupiter.execution.parallel.mode.default = ${parallel.mode}
                            junit.jupiter.execution.parallel.mode.classes.default = ${parallel.mode}
                        </configurationParameters>
                    </properties>
                    <rerunFailingTestsCount>3</rerunFailingTestsCount>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <outputName>YouTrack-test-report</outputName>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/test/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

</project>